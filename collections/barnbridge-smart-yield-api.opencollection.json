{
  "opencollection": "1.0.0",
  "info": {
    "name": "BarnBridge Governance SMART Yield API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "SMART Yield",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List SMART Yield pools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-v2.barnbridge.com/api/smartyield/pools",
            "params": [
              {
                "name": "originator",
                "value": "compound/v2",
                "type": "query",
                "description": "Comma-separated list of originator protocol IDs, or \"all\" (default)."
              },
              {
                "name": "underlyingSymbol",
                "value": "USDC",
                "type": "query",
                "description": "Underlying asset symbol filter (case-insensitive), or \"all\" (default)."
              }
            ]
          },
          "docs": "Returns all SMART Yield structured-product pools with current liquidity, APY, and state data. Optionally filter by originator protocol or underlying token symbol."
        },
        {
          "info": {
            "name": "Get SMART Yield pool by address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-v2.barnbridge.com/api/smartyield/pools/:address",
            "params": [
              {
                "name": "address",
                "value": "0x4B8d90D68F26DEF303Dcb6CFc9b63A1aAEC15840",
                "type": "path",
                "description": "Ethereum address of the SMART Yield pool (checksummed or lowercase)."
              }
            ]
          },
          "docs": "Get SMART Yield pool by address"
        },
        {
          "info": {
            "name": "Get APY trend for a SMART Yield pool",
            "type": "http"
